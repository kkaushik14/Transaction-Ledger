# Transaction Ledger: ignore local dependencies, generated output, and secrets.
# Commit source, migrations, documentation, shared configuration, and pnpm-lock.yaml.

# Dependencies and local package-manager stores
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Build output and tooling caches (at any workspace depth)
dist/
build/
out/
.vite/
.vite-temp/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Test coverage and generated test reports
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/
*.lcov

# Local environment values; placeholder templates remain versioned
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
.envrc

# Local credentials and private keys; public certificates remain versionable
.npmrc.local
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
!*.pub

# Supabase CLI local state; keep config.toml, migrations, and seed.sql
supabase/.temp/
supabase/.branches/
.supabase/

# Local database files and exports; do not ignore SQL migration sources
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
*.dump
*.backup

# Logs, runtime state, and diagnostic reports
logs/
*.log
*.pid
*.pid.lock
*.seed
*.stackdump
report.*.json

# Temporary and backup files
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo
.history/

# Editor-local state; keep portable VS Code project configuration
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/*.code-snippets

# Operating-system metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
