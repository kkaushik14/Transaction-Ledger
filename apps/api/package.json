{
  "name": "@ledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "db:check": "tsx --env-file-if-exists=.env src/db/check-connection.ts"
  },
  "dependencies": {
    "@ledger/contracts": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "0.5.12",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "17.10.0-beta.17",
    "openapi3-ts": "4.6.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
