# Server-only PostgreSQL URI from Supabase Dashboard > Connect > Session pooler.
# Use your exact dashboard hostname/user and URL-encode password characters.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Direct connection alternative (requires network support for its address):
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional: defaults to the bundled public Supabase CA, independently of cwd.
# Override paths are relative to apps/api unless absolute. No private key is needed.
DATABASE_SSL_CA_PATH=../../supabase/certs/prod-ca-2021.crt
DATABASE_POOL_MAX=5
# Verified TLS is mandatory. sslmode=require/verify-ca/verify-full URL hints are
# accepted then removed so pg cannot overwrite our explicit verified TLS settings.
# Other URL query parameters and insecure SSL modes are rejected.

# Required baseline API configuration. WEB_ORIGIN is validated now; CORS comes later.
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Reserved for future isolated integration tests; never use live ledger data.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_TEST_PASSWORD@YOUR_TEST_DATABASE_HOST:5432/postgres
# No Supabase API key is needed. Never put DATABASE_URL or secrets in VITE_* values.
